<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_RecordOperationL1"
  targetNamespace="https://github.com/anton415/go-investment-ledger/docs/processes">

  <bpmn:error id="Error_TechnicalFailure" name="Technical failure" errorCode="TECHNICAL_FAILURE" />

  <bpmn:process id="Process_RecordOperationL1" name="Record operation L1 — documentation only" isExecutable="false">
    <bpmn:documentation>
      Documentation-only model. It is not deployed to Camunda Runtime. Investment Ledger owns validation,
      idempotency, financial invariants, atomic append and retry semantics.
    </bpmn:documentation>

    <bpmn:startEvent id="StartEvent_CommandReceived" name="Command received">
      <bpmn:outgoing>Flow_Start_Validate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Validate" name="Validate request envelope and idempotency key">
      <bpmn:incoming>Flow_Start_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Result</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Validation" name="Request envelope valid?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Validate_Result</bpmn:incoming>
      <bpmn:outgoing>Flow_Validation_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Validation_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_ValidationRejected" name="Request rejected before command registration">
      <bpmn:incoming>Flow_Validation_Invalid</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_CheckIdempotency" name="Check or reserve idempotency key and payload fingerprint">
      <bpmn:incoming>Flow_Validation_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_Idempotency_Result</bpmn:outgoing>
    </bpmn:task>

    <bpmn:boundaryEvent
      id="BoundaryEvent_IdempotencyTechnicalFailure"
      name="Storage failure"
      attachedToRef="Task_CheckIdempotency"
      cancelActivity="true">
      <bpmn:outgoing>Flow_Technical_Idempotency</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Idempotency" errorRef="Error_TechnicalFailure" />
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="Gateway_IdentityState" name="Idempotency state?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Idempotency_Result</bpmn:incoming>
      <bpmn:outgoing>Flow_Identity_New</bpmn:outgoing>
      <bpmn:outgoing>Flow_Identity_SamePayload</bpmn:outgoing>
      <bpmn:outgoing>Flow_Identity_DifferentPayload</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ReturnSavedResult" name="Return saved terminal result">
      <bpmn:incoming>Flow_Identity_SamePayload</bpmn:incoming>
      <bpmn:outgoing>Flow_SavedResult_End</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_SavedResult" name="Saved result returned">
      <bpmn:incoming>Flow_SavedResult_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Conflict" name="Conflict — journal unchanged">
      <bpmn:incoming>Flow_Identity_DifferentPayload</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_LoadState" name="Load operations and calculate state">
      <bpmn:incoming>Flow_Identity_New</bpmn:incoming>
      <bpmn:outgoing>Flow_State_CheckRules</bpmn:outgoing>
    </bpmn:task>

    <bpmn:boundaryEvent
      id="BoundaryEvent_LoadStateTechnicalFailure"
      name="Storage failure"
      attachedToRef="Task_LoadState"
      cancelActivity="true">
      <bpmn:outgoing>Flow_Technical_LoadState</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_LoadState" errorRef="Error_TechnicalFailure" />
    </bpmn:boundaryEvent>

    <bpmn:task id="Task_CheckInvariants" name="Validate domain values, cash and position invariants">
      <bpmn:incoming>Flow_State_CheckRules</bpmn:incoming>
      <bpmn:outgoing>Flow_Rules_Result</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Invariants" name="Command acceptable?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Rules_Result</bpmn:incoming>
      <bpmn:outgoing>Flow_Invariants_Satisfied</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invariants_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_BusinessRejected" name="Business rejection saved — journal unchanged">
      <bpmn:incoming>Flow_Invariants_Rejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_Append" name="Atomically append operations and save result">
      <bpmn:incoming>Flow_Invariants_Satisfied</bpmn:incoming>
      <bpmn:outgoing>Flow_Append_Return</bpmn:outgoing>
    </bpmn:task>

    <bpmn:boundaryEvent
      id="BoundaryEvent_AppendTechnicalFailure"
      name="Unknown append outcome"
      attachedToRef="Task_Append"
      cancelActivity="true">
      <bpmn:outgoing>Flow_Technical_Append</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Append" errorRef="Error_TechnicalFailure" />
    </bpmn:boundaryEvent>

    <bpmn:task id="Task_ReturnSuccess" name="Return successful result">
      <bpmn:incoming>Flow_Append_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_Success_End</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Accepted" name="Operation accepted">
      <bpmn:incoming>Flow_Success_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_TechnicalFailureMerge" name="Technical failure" gatewayDirection="Converging">
      <bpmn:incoming>Flow_Technical_Idempotency</bpmn:incoming>
      <bpmn:incoming>Flow_Technical_LoadState</bpmn:incoming>
      <bpmn:incoming>Flow_Technical_Append</bpmn:incoming>
      <bpmn:outgoing>Flow_Technical_Return</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ReturnTechnicalFailure" name="Return technical failure; allow retry with same idempotency key">
      <bpmn:incoming>Flow_Technical_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_Technical_End</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_TechnicalFailure" name="Technical failure">
      <bpmn:incoming>Flow_Technical_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Validate" sourceRef="StartEvent_CommandReceived" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_Validate_Result" sourceRef="Task_Validate" targetRef="Gateway_Validation" />
    <bpmn:sequenceFlow id="Flow_Validation_Valid" name="Yes" sourceRef="Gateway_Validation" targetRef="Task_CheckIdempotency">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">validationResult = "valid"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Validation_Invalid" name="No" sourceRef="Gateway_Validation" targetRef="EndEvent_ValidationRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">validationResult = "invalid"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Idempotency_Result" sourceRef="Task_CheckIdempotency" targetRef="Gateway_IdentityState" />
    <bpmn:sequenceFlow id="Flow_Identity_New" name="New or incomplete" sourceRef="Gateway_IdentityState" targetRef="Task_LoadState">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">identityState = "new" or identityState = "same-payload-without-result"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Identity_SamePayload" name="Terminal result" sourceRef="Gateway_IdentityState" targetRef="Task_ReturnSavedResult">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">identityState = "same-payload-with-result"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Identity_DifferentPayload" name="Different payload" sourceRef="Gateway_IdentityState" targetRef="EndEvent_Conflict">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">identityState = "different-payload"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SavedResult_End" sourceRef="Task_ReturnSavedResult" targetRef="EndEvent_SavedResult" />
    <bpmn:sequenceFlow id="Flow_State_CheckRules" sourceRef="Task_LoadState" targetRef="Task_CheckInvariants" />
    <bpmn:sequenceFlow id="Flow_Rules_Result" sourceRef="Task_CheckInvariants" targetRef="Gateway_Invariants" />
    <bpmn:sequenceFlow id="Flow_Invariants_Satisfied" name="Yes" sourceRef="Gateway_Invariants" targetRef="Task_Append">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">invariantsResult = "satisfied"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Invariants_Rejected" name="No" sourceRef="Gateway_Invariants" targetRef="EndEvent_BusinessRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">invariantsResult = "rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Append_Return" sourceRef="Task_Append" targetRef="Task_ReturnSuccess" />
    <bpmn:sequenceFlow id="Flow_Success_End" sourceRef="Task_ReturnSuccess" targetRef="EndEvent_Accepted" />
    <bpmn:sequenceFlow id="Flow_Technical_Idempotency" sourceRef="BoundaryEvent_IdempotencyTechnicalFailure" targetRef="Gateway_TechnicalFailureMerge" />
    <bpmn:sequenceFlow id="Flow_Technical_LoadState" sourceRef="BoundaryEvent_LoadStateTechnicalFailure" targetRef="Gateway_TechnicalFailureMerge" />
    <bpmn:sequenceFlow id="Flow_Technical_Append" sourceRef="BoundaryEvent_AppendTechnicalFailure" targetRef="Gateway_TechnicalFailureMerge" />
    <bpmn:sequenceFlow id="Flow_Technical_Return" sourceRef="Gateway_TechnicalFailureMerge" targetRef="Task_ReturnTechnicalFailure" />
    <bpmn:sequenceFlow id="Flow_Technical_End" sourceRef="Task_ReturnTechnicalFailure" targetRef="EndEvent_TechnicalFailure" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_RecordOperationL1">
    <bpmndi:BPMNPlane id="BPMNPlane_RecordOperationL1" bpmnElement="Process_RecordOperationL1">
      <bpmndi:BPMNShape id="Shape_StartEvent_CommandReceived" bpmnElement="StartEvent_CommandReceived">
        <dc:Bounds x="45" y="220" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="25" y="260" width="86" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Validate" bpmnElement="Task_Validate">
        <dc:Bounds x="110" y="198" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Validation" bpmnElement="Gateway_Validation" isMarkerVisible="true">
        <dc:Bounds x="330" y="213" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="300" y="165" width="110" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_ValidationRejected" bpmnElement="EndEvent_ValidationRejected">
        <dc:Bounds x="337" y="370" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="275" y="410" width="160" height="35" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CheckIdempotency" bpmnElement="Task_CheckIdempotency">
        <dc:Bounds x="430" y="198" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BoundaryEvent_IdempotencyTechnicalFailure" bpmnElement="BoundaryEvent_IdempotencyTechnicalFailure">
        <dc:Bounds x="570" y="263" width="30" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_IdentityState" bpmnElement="Gateway_IdentityState" isMarkerVisible="true">
        <dc:Bounds x="670" y="208" width="60" height="60" />
        <bpmndi:BPMNLabel><dc:Bounds x="635" y="275" width="130" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReturnSavedResult" bpmnElement="Task_ReturnSavedResult">
        <dc:Bounds x="800" y="55" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_SavedResult" bpmnElement="EndEvent_SavedResult">
        <dc:Bounds x="1040" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="995" y="118" width="130" height="35" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Conflict" bpmnElement="EndEvent_Conflict">
        <dc:Bounds x="682" y="370" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="610" y="410" width="180" height="35" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_LoadState" bpmnElement="Task_LoadState">
        <dc:Bounds x="800" y="198" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BoundaryEvent_LoadStateTechnicalFailure" bpmnElement="BoundaryEvent_LoadStateTechnicalFailure">
        <dc:Bounds x="930" y="263" width="30" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CheckInvariants" bpmnElement="Task_CheckInvariants">
        <dc:Bounds x="1030" y="198" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Invariants" bpmnElement="Gateway_Invariants" isMarkerVisible="true">
        <dc:Bounds x="1270" y="208" width="60" height="60" />
        <bpmndi:BPMNLabel><dc:Bounds x="1240" y="165" width="120" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_BusinessRejected" bpmnElement="EndEvent_BusinessRejected">
        <dc:Bounds x="1282" y="370" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1205" y="410" width="190" height="35" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Append" bpmnElement="Task_Append">
        <dc:Bounds x="1380" y="198" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BoundaryEvent_AppendTechnicalFailure" bpmnElement="BoundaryEvent_AppendTechnicalFailure">
        <dc:Bounds x="1530" y="263" width="30" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReturnSuccess" bpmnElement="Task_ReturnSuccess">
        <dc:Bounds x="1630" y="198" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Accepted" bpmnElement="EndEvent_Accepted">
        <dc:Bounds x="1850" y="220" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1810" y="260" width="120" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_TechnicalFailureMerge" bpmnElement="Gateway_TechnicalFailureMerge" isMarkerVisible="true">
        <dc:Bounds x="1580" y="470" width="60" height="60" />
        <bpmndi:BPMNLabel><dc:Bounds x="1540" y="535" width="140" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReturnTechnicalFailure" bpmnElement="Task_ReturnTechnicalFailure">
        <dc:Bounds x="1690" y="460" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_TechnicalFailure" bpmnElement="EndEvent_TechnicalFailure">
        <dc:Bounds x="1940" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1880" y="522" width="160" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_Start_Validate" bpmnElement="Flow_Start_Validate">
        <di:waypoint x="81" y="238" /><di:waypoint x="110" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Validate_Result" bpmnElement="Flow_Validate_Result">
        <di:waypoint x="280" y="238" /><di:waypoint x="330" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Validation_Valid" bpmnElement="Flow_Validation_Valid">
        <di:waypoint x="380" y="238" /><di:waypoint x="430" y="238" />
        <bpmndi:BPMNLabel><dc:Bounds x="394" y="214" width="24" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Validation_Invalid" bpmnElement="Flow_Validation_Invalid">
        <di:waypoint x="355" y="263" /><di:waypoint x="355" y="370" />
        <bpmndi:BPMNLabel><dc:Bounds x="362" y="302" width="20" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Idempotency_Result" bpmnElement="Flow_Idempotency_Result">
        <di:waypoint x="620" y="238" /><di:waypoint x="670" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Identity_New" bpmnElement="Flow_Identity_New">
        <di:waypoint x="730" y="238" /><di:waypoint x="800" y="238" />
        <bpmndi:BPMNLabel><dc:Bounds x="746" y="214" width="30" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Identity_SamePayload" bpmnElement="Flow_Identity_SamePayload">
        <di:waypoint x="700" y="208" /><di:waypoint x="700" y="95" /><di:waypoint x="800" y="95" />
        <bpmndi:BPMNLabel><dc:Bounds x="705" y="70" width="82" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Identity_DifferentPayload" bpmnElement="Flow_Identity_DifferentPayload">
        <di:waypoint x="700" y="268" /><di:waypoint x="700" y="370" />
        <bpmndi:BPMNLabel><dc:Bounds x="708" y="310" width="98" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_SavedResult_End" bpmnElement="Flow_SavedResult_End">
        <di:waypoint x="990" y="95" /><di:waypoint x="1040" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_State_CheckRules" bpmnElement="Flow_State_CheckRules">
        <di:waypoint x="980" y="238" /><di:waypoint x="1030" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Rules_Result" bpmnElement="Flow_Rules_Result">
        <di:waypoint x="1220" y="238" /><di:waypoint x="1270" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Invariants_Satisfied" bpmnElement="Flow_Invariants_Satisfied">
        <di:waypoint x="1330" y="238" /><di:waypoint x="1380" y="238" />
        <bpmndi:BPMNLabel><dc:Bounds x="1344" y="214" width="24" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Invariants_Rejected" bpmnElement="Flow_Invariants_Rejected">
        <di:waypoint x="1300" y="268" /><di:waypoint x="1300" y="370" />
        <bpmndi:BPMNLabel><dc:Bounds x="1307" y="310" width="20" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Append_Return" bpmnElement="Flow_Append_Return">
        <di:waypoint x="1580" y="238" /><di:waypoint x="1630" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Success_End" bpmnElement="Flow_Success_End">
        <di:waypoint x="1800" y="238" /><di:waypoint x="1850" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Technical_Idempotency" bpmnElement="Flow_Technical_Idempotency">
        <di:waypoint x="585" y="293" /><di:waypoint x="585" y="460" /><di:waypoint x="1550" y="460" /><di:waypoint x="1550" y="500" /><di:waypoint x="1580" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Technical_LoadState" bpmnElement="Flow_Technical_LoadState">
        <di:waypoint x="945" y="293" /><di:waypoint x="945" y="480" /><di:waypoint x="1580" y="480" /><di:waypoint x="1610" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Technical_Append" bpmnElement="Flow_Technical_Append">
        <di:waypoint x="1545" y="293" /><di:waypoint x="1545" y="410" /><di:waypoint x="1610" y="410" /><di:waypoint x="1610" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Technical_Return" bpmnElement="Flow_Technical_Return">
        <di:waypoint x="1640" y="500" /><di:waypoint x="1690" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Technical_End" bpmnElement="Flow_Technical_End">
        <di:waypoint x="1890" y="500" /><di:waypoint x="1940" y="500" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
